# Copy to .env for local development. All values are optional.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Unset uses SQLite; docker-compose sets PostgreSQL.
# DATABASE_URL=postgres://fuel_planner:fuel_planner@localhost:5432/fuel_planner
# Comma-separated OSRM servers, tried in order (failover only).
# OSRM_BASE_URLS=https://routing.openstreetmap.de/routed-car,https://router.project-osrm.org
# OSRM_TIMEOUT_SECONDS=10
# Redis enables real background workers and the shared route cache.
# Unset: jobs run inline and routes are cached in the database.
# REDIS_URL=redis://localhost:6379/0
# THROTTLE_SYNC_MILP=10/min
# THROTTLE_JOBS=60/min
