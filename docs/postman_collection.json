{
  "info": {
    "name": "Fuel Route Planner",
    "description": "Demo collection for the Fuel Route Planner API. Run the folders in order; see docs/DEMO.md.\n\nReset first: `docker compose exec web python manage.py demo_reset`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "mapUrl",
      "value": ""
    },
    {
      "key": "jobUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. One API call",
      "item": [
        {
          "name": "Routing stats (before)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stats/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stats",
                ""
              ]
            },
            "description": "All counters should be 0 after demo_reset."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = pm.response.json(); console.log(`routing API calls so far: ${s.routing_api_calls}, cache: ${s.cache_backend}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Plan NY -> LA (new route: 1 OSRM call)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/route-plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "route-plan",
                ""
              ]
            },
            "description": "First request for this trip: meta.routing_api_calls = 1, routing_cache_hit = false.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"mapUrl\", d.map_url);",
                  "console.log(`${d.start.label} -> ${d.finish.label} [${d.strategy}]: $${d.summary.total_fuel_cost}, ${d.summary.number_of_stops} stops, routing API calls: ${d.meta.routing_api_calls}, ${pm.response.responseTime} ms`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Plan NY -> LA again (cached: 0 OSRM calls)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/route-plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "route-plan",
                ""
              ]
            },
            "description": "Same trip: served from the Redis route cache in milliseconds.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"mapUrl\", d.map_url);",
                  "console.log(`${d.start.label} -> ${d.finish.label} [${d.strategy}]: $${d.summary.total_fuel_cost}, ${d.summary.number_of_stops} stops, routing API calls: ${d.meta.routing_api_calls}, ${pm.response.responseTime} ms`);",
                  "pm.test(\"served from cache\", () => pm.expect(pm.response.json().meta.routing_api_calls).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Open the map (paste mapUrl in a browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/route-plan/map/?start=New York, NY&finish=Los Angeles, CA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "route-plan",
                "map",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "New York, NY"
                },
                {
                  "key": "finish",
                  "value": "Los Angeles, CA"
                }
              ]
            },
            "description": "HTML map with the route and numbered fuel stops. Easier to open {{mapUrl}} in a browser tab."
          }
        }
      ]
    },
